# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# leftover create-next-app nest (do not ship)
/pacific-properties-goa

# oversized hero source files (encoded copies live in /public/videos)
/media/originals/hero/*-1080.mp4
/media/originals/hero/*-720.mp4
/media/originals/hero/.candidates/

# local QA screenshots
/.qa
/.tmp-qa

# private source review stills (never publish)
/media/review
